theme = "Arstotzka"
font-family = "MonacoNerdFont"
font-size = 10
window-save-state = always
clipboard-read = allow
clipboard-write = allow
copy-on-select = true
window-subtitle = working-directory
window-theme = dark
background-opacity = 0.93
background-blur = 20
adjust-cell-height = 50%
quick-terminal-position = top
quick-terminal-size = 100%
keybind = global:ctrl+cmd+t=toggle_quick_terminal
keybind = global:ctrl+alt+t=toggle_quick_terminal
macos-hidden=always
